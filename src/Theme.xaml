<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:HallowGear;assembly=HallowGear">
    <!-- Hallow Gear: the modern Hallow look (Hallow Hub 2.28): dark purple-black, calm surfaces instead of lines, the Hallow accent
         (#F07820 is swapped for theme.json's accent, also in its #AARRGGBB forms) on the one primary action, the open tab and progress,
         and the family green / amber / red for battery states. EVERY colour the app uses is a brush in this file (the code only asks
         for keys). Light mode (1.1) swaps the values of the same keys (Look.cs) and darkens the accent for text. -->
    <h:IconConv x:Key="IconConv"/><h:IconVis x:Key="IconVis"/><h:LabelVis x:Key="LabelVis"/><h:IconGap x:Key="IconGap"/>
    <!-- surfaces -->
    <SolidColorBrush x:Key="Bg" Color="#16121C"/>
    <SolidColorBrush x:Key="Side" Color="#120F17"/>
    <SolidColorBrush x:Key="Panel" Color="#211B2A"/>
    <SolidColorBrush x:Key="PanelHi" Color="#2E2639"/>
    <SolidColorBrush x:Key="Well" Color="#1A1522"/>
    <SolidColorBrush x:Key="Line" Color="#3A3248"/>
    <SolidColorBrush x:Key="LineDim" Color="#2A2336"/>
    <SolidColorBrush x:Key="BtnBg" Color="#2A2333"/>
    <SolidColorBrush x:Key="BtnLine" Color="#3A3248"/>
    <SolidColorBrush x:Key="BtnHover" Color="#55496A"/>
    <!-- a see-through veil under the mouse (ghost buttons, rows): the text colour at low opacity, so it works in light and dark -->
    <SolidColorBrush x:Key="Veil" Color="#ECE8F4"/>
    <!-- the on/off switch -->
    <SolidColorBrush x:Key="SwitchOff" Color="#58566A"/>
    <SolidColorBrush x:Key="SwitchKnob" Color="#CDCAD6"/>
    <SolidColorBrush x:Key="SwitchKnobOn" Color="#FFFFFF"/>
    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#ECE8F4"/>
    <SolidColorBrush x:Key="TextSoft" Color="#CFC8DC"/>
    <SolidColorBrush x:Key="Muted" Color="#8F88A0"/>
    <SolidColorBrush x:Key="Faint" Color="#6E6684"/>
    <!-- the accent (Hallow) and the family colours -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F07820"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F59A50"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#33F07820"/>
    <SolidColorBrush x:Key="OnAccent" Color="#1A0E04"/>
    <SolidColorBrush x:Key="Lilac" Color="#A98BE0"/>
    <SolidColorBrush x:Key="LilacDim" Color="#6E5A96"/>
    <SolidColorBrush x:Key="Green" Color="#6ED28C"/>
    <SolidColorBrush x:Key="Amber" Color="#F0BE5A"/>
    <SolidColorBrush x:Key="Red" Color="#E05A64"/>
    <SolidColorBrush x:Key="RedBg" Color="#33E05A64"/>
    <SolidColorBrush x:Key="AmberBg" Color="#2EF0BE5A"/>
    <SolidColorBrush x:Key="GreenBg" Color="#266ED28C"/>
    <SolidColorBrush x:Key="LilacBg" Color="#2EA98BE0"/>
    <!-- the process list: selected row, hover, and the usage tint of a cell (0 = none ... 3 = heavy), like Task Manager's -->
    <SolidColorBrush x:Key="RowSel" Color="#3DF07820"/>
    <SolidColorBrush x:Key="RowHover" Color="#1FA98BE0"/>
    <SolidColorBrush x:Key="RowChild" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Heat0" Color="#00000000"/>
    <SolidColorBrush x:Key="Heat1" Color="#1FF07820"/>
    <SolidColorBrush x:Key="Heat2" Color="#3DF07820"/>
    <SolidColorBrush x:Key="Heat3" Color="#66F07820"/>
    <!-- graphs -->
    <SolidColorBrush x:Key="GraphBg" Color="#100D16"/>
    <SolidColorBrush x:Key="GraphGrid" Color="#2A2336"/>
    <SolidColorBrush x:Key="GraphCpu" Color="#F07820"/>
    <SolidColorBrush x:Key="GraphCpuFill" Color="#2EF07820"/>
    <SolidColorBrush x:Key="Graph3D" Color="#A98BE0"/>
    <SolidColorBrush x:Key="Graph3DFill" Color="#2EA98BE0"/>
    <SolidColorBrush x:Key="GraphEncode" Color="#6ED28C"/>
    <SolidColorBrush x:Key="GraphDecode" Color="#F0BE5A"/>
    <SolidColorBrush x:Key="GraphCopy" Color="#5AB4F0"/>
    <SolidColorBrush x:Key="GraphRam" Color="#6ED28C"/>
    <SolidColorBrush x:Key="GraphRamFill" Color="#266ED28C"/>
    <SolidColorBrush x:Key="GraphVram" Color="#A98BE0"/>
    <SolidColorBrush x:Key="GraphVramFill" Color="#2EA98BE0"/>
    <SolidColorBrush x:Key="GraphRead" Color="#5AB4F0"/>
    <SolidColorBrush x:Key="GraphReadFill" Color="#265AB4F0"/>
    <SolidColorBrush x:Key="GraphWrite" Color="#F07820"/>
    <SolidColorBrush x:Key="GraphDown" Color="#6ED28C"/>
    <SolidColorBrush x:Key="GraphDownFill" Color="#266ED28C"/>
    <SolidColorBrush x:Key="GraphUp" Color="#F0BE5A"/>
    <!-- History: spike and stutter marks, the band while a game ran -->
    <SolidColorBrush x:Key="SpikeMark" Color="#F0BE5A"/>
    <SolidColorBrush x:Key="StutterMark" Color="#E05A64"/>
    <SolidColorBrush x:Key="GameBand" Color="#146ED28C"/>
    <!-- the letter tile for processes without an icon -->
    <SolidColorBrush x:Key="TileBg" Color="#2E2640"/>
    <SolidColorBrush x:Key="TileText" Color="#A98BE0"/>
    <!-- checked toggles (a Btn that is on) -->
    <SolidColorBrush x:Key="CheckedBg" Color="#40F07820"/>
    <SolidColorBrush x:Key="CheckedLine" Color="#F07820"/>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="HeadFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="NeonFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="#F07820" StrokeThickness="1.5" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource NeonFocus}"/>

    <!-- Buttons: icon (from the label, see Icons.cs) + text, rounded, a soft veil under the mouse. Tag="icon" = icon only. -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource BtnBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BtnLine}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                        <Border x:Name="hl" Background="{StaticResource Veil}" Opacity="0" CornerRadius="8"/>
                        <StackPanel x:Name="sp" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ic" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconConv}}"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconVis}}"
                                  Margin="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGap}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.07"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BtnHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.14"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        <Trigger Property="Tag" Value="icon"><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/><Setter TargetName="ic" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CheckedBg}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource CheckedLine}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the one primary action: filled with the accent -->
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="#F07820"/>
        <Setter Property="BorderBrush" Value="#F07820"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource RedBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- a ghost button - no fill or line, a soft veil under the mouse (secondary actions) -->
    <Style x:Key="Ghost" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                        <Border x:Name="hl" Background="{StaticResource Veil}" Opacity="0" CornerRadius="8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Path x:Name="ic" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconConv}}"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconVis}}"
                                  Margin="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGap}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                  Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelVis}}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.08"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.14"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        <Trigger Property="Tag" Value="icon"><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/><Setter TargetName="ic" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.12"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- a quiet choice chip: a soft surface, no line; the one that is on is filled with the text colour (the accent stays for actions) -->
    <Style x:Key="Pill" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="Background" Value="{StaticResource PanelHi}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <Border x:Name="hl" Background="{StaticResource Veil}" Opacity="0" CornerRadius="8"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.07"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="hl" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Pill}"/>
    <!-- top navigation - text tabs, the accent underline on the open one -->
    <Style x:Key="Tab" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border x:Name="u" Height="3" VerticalAlignment="Bottom" Margin="12,0,12,0" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter TargetName="u" Property="Background" Value="#F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- On/off switch: green = on, grey = off -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="track" DockPanel.Dock="Left" Width="40" Height="22" CornerRadius="11" Background="{StaticResource SwitchOff}" VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="{StaticResource SwitchKnob}" HorizontalAlignment="Left" Margin="3,0,3,0"/>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Green}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource SwitchKnobOn}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource Switch}"/>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,0" MinHeight="32">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,6,18,6">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter ContentSource="Icon" Width="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{StaticResource LineDim}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="460"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- slim scroll bars - a rounded thumb, no arrows or track -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Background="{StaticResource Line}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource BtnHover}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource BtnHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="3,2,3,2"/></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="2,3,2,3"/></Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
